# Separate frontend/API deployments: use the public backend origin without a trailing slash.
VITE_API_BASE=https://your-api-host.example.com

# Optional Amap JavaScript API. This key is embedded in the public frontend bundle;
# restrict it to your deployed domain in the Amap console.
VITE_AMAP_KEY=
VITE_AMAP_SECURITY_CODE=
