# ===== 后端密钥（复制到 .env 后填入真实值，.env 已被 .gitignore 忽略） =====

# 大模型（OpenAI 兼容，可换 DeepSeek / 通义千问等）
LLM_API_KEY=你的key
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
# 可选：用于在每次规划结果中估算费用；按所用模型的官方单价填写。
LLM_INPUT_COST_PER_1M_USD=0
LLM_OUTPUT_COST_PER_1M_USD=0

# 高德 Web 服务 Key（POI 搜索与天气，必填）
AMAP_API_KEY=你的高德Web服务key
# true 时查询真实驾车距离与时长；接口失败自动回退为直线距离。
USE_AMAP_DRIVING_ROUTE=true

# Pexels 免费图库（封面图首选，可选）：免费 key 在 https://www.pexels.com/api 申请，
# 额度 200 次/时、2 万次/月，免署名、可外链。留空则自动落到 Openverse 兜底，不影响运行。
PEXELS_API_KEY=

# 百度地图服务端 AK（市内打车路线参考价，可选）：未配置时尝试使用高德 AMAP_API_KEY；
# 两种路线服务都不可用时，不生成虚构车费，市内打车费用不计入预算。
# 申请：https://lbsyun.baidu.com/（服务端 AK，启用 路线规划）
BAIDU_MAP_AK=


# 12306 真实火车票票价（可选）：true 时，填写出发城市后交通显示真实往返票价，
# 并返回「车次选择推荐」（去程/返程 + 候选车次表格 + 推荐班次）。
# 实现为直连 12306 官方公开接口（免 key、免 npx/Node），查询不到时交通自动回退为估算。
# 注意：12306 预售期约 15 天，超出预售期的日期查不到车次属正常现象。
USE_RAIL_MCP=false
# 偏好席别（用于从 12306 返回的各席别中取价）：二等座 / 一等座 / 商务座 / 硬座 / 硬卧 ...
RAIL_MCP_SEAT_CLASS=二等座

# ===== 服务绑定（可选，仅部署时覆盖） =====
# API 默认监听 127.0.0.1；如需对外暴露再设为 0.0.0.0（请同时配置 CORS 与认证）
HOST=127.0.0.1
PORT=8000
# 允许跨域的来源（逗号分隔）；留空则使用本地默认来源
CORS_ORIGINS=
